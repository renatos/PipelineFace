# ==============================================
# Containerfile para o Scraper do Facebook
# Utiliza Playwright (automação de navegador) e
# yt-dlp (download de vídeos) para coletar mídia
# de perfis de terceiros com conta autenticada.
# ==============================================

FROM python:3.12-slim

# Instalar dependências do sistema
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    curl \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

# Instalar dependências Python
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Instalar navegadores do Playwright (apenas Chromium para economia de espaço)
RUN playwright install chromium && playwright install-deps chromium

# Copiar código do scraper
COPY . /app
WORKDIR /app

# Criar diretórios necessários
RUN mkdir -p /data/input/videos /data/input/images /data/input/metadata /data/scraper/session

# O container fica idle, N8N ou scripts chamam via exec
ENTRYPOINT ["python"]
CMD ["facebook_scraper.py", "--help"]
