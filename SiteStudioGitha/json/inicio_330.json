-em-bh/\"\n            },\n            \"price\": \"590.00\",\n            \"priceCurrency\": \"BRL\"\n          },\n          {\n            \"@type\": \"Offer\",\n            \"itemOffered\": {\n              \"@type\": \"Service\",\n              \"name\": \"Limpeza de Pele em BH\",\n              \"url\": \"https://studiogitha.com/limpeza-de-pele-em-bh/\"\n            },\n            \"price\": \"250.00\",\n            \"priceCurrency\": \"BRL\"\n          },\n          {\n            \"@type\": \"Offer\",\n            \"itemOffered\": {\n              \"@type\": \"Service\",\n              \"name\": \"Peelings e Microagulhamento em BH\",\n              \"url\": \"https://studiogitha.com/peeling-e-microagulhamento-em-bh/\"\n            },\n            \"price\": \"300.00\",\n            \"priceCurrency\": \"BRL\"\n          },\n          {\n            \"@type\": \"Offer\",\n            \"itemOffered\": {\n              \"@type\": \"Service\",\n              \"name\": \"Massagem Facial em BH\",\n              \"url\": \"https://studiogitha.com/massagem-facial-em-bh/\"\n            },\n            \"price\": \"120.00\",\n            \"priceCurrency\": \"BRL\"\n          }\n        ]\n      },\n      \"sameAs\": [\n        \"https://www.instagram.com/githastudio\"\n      ]\n    },\n    {\n      \"@type\": \"FAQPage\",\n      \"@id\": \"https://studiogitha.com/#faq\",\n      \"mainEntity\": [\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Como funciona o agendamento no Studio Githa?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"text\": \"Os atendimentos são realizados exclusivamente com horário marcado pelo nosso WhatsApp oficial, garantindo pontualidade e dedicação total a você.\"\n          }\n        },\n        {\n          \"@type\": \"Question\",\n          \"name\": \"Quais formas de pagamento são aceitas?\",\n          \"acceptedAnswer\": {\n            \"@type\": \"Answer\",\n            \"tex