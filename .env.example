# ============================================
# PipelineFace - Variáveis de Ambiente (Exemplo)
# ============================================

# --- PostgreSQL ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=n8n

# --- N8N ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo

# --- Conexão com Banco de Dados ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=sua_senha_aqui

# Permissões do Sandbox Javascript do N8N para ler arquivos locais
NODE_FUNCTION_ALLOW_BUILTIN=fs,path,child_process
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true

# --- Ollama ---
OLLAMA_HOST=http://host.docker.internal:11434

# --- Whisper ---
WHISPER_HOST=http://whisper:9000

# --- Modelos ---
VISION_MODEL=moondream
TEXT_MODEL=qwen2.5:7b
WHISPER_MODEL=base

# --- Scraper Facebook ---
SCRAPER_MAX_SCROLLS=50
SCRAPER_SESSION_DIR=/data/scraper/session
